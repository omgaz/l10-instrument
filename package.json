{
  "name": "l10-instrument",
  "version": "0.0.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:pages": "node scripts/pages.ts",
    "check": "npm run lint && tsc && node --test scripts/build.test.ts && node scripts/build.ts --check",
    "lint": "eslint scripts && prettier --check .",
    "fix": "eslint scripts --fix && prettier --write .",
    "test": "node --test scripts/build.test.ts"
  },
  "devDependencies": {
    "@types/culori": "^4.0.0",
    "@types/node": "^26.0.0",
    "ajv": "^8.17.1",
    "culori": "^4.0.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}

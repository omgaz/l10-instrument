  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6C6C6C"
      }
    },
    {
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#6C6C6C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#AD4439"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#2B6FAC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#006878"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#8F4B03"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#59644D"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#20211F"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#334C5B"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#90326C"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#90326C"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#555653"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#6F6F6C"
      }
    },
    {
      "scope": [
        "punctuation.section",
        "punctuation.section.braces"
      ],
      "settings": {
        "foreground": "#626260"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other"
      ],
      "settings": {
        "foreground": "#8F4B03"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#AD4439"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#59644D"
      }
    },
    {
      "scope": [
        "comment.block.documentation storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#9B6058",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment.block.documentation entity.name.type.jsdoc"
      ],
      "settings": {
        "foreground": "#517395"
      }
    },
    {
      "scope": [
        "comment.block.documentation entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#517395",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment.block.documentation variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#70706F"
      }
    },
    {
      "scope": [
        "comment.block.documentation variable.other.description.jsdoc",
        "comment.block.documentation constant.other.description.jsdoc"
      ],
      "settings": {
        "foreground": "#6C6C6C"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#2B6FAC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#334C5B"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#005E72"
      }
    },
    {
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.heading.markdown",
        "punctuation.definition.bold.markdown",
        "punctuation.definition.italic.markdown",
        "punctuation.definition.link.markdown"
      ],
      "settings": {
        "foreground": "#6F6F6C"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "foreground": "#2B6FAC",
      "bold": true
    },
    "interface": {
      "foreground": "#2B6FAC",
      "bold": true
    },
    "enum": {
      "foreground": "#2B6FAC",
      "bold": true
    },
    "type": {
      "foreground": "#2B6FAC",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#2B6FAC"
    },
    "function": {
      "foreground": "#006878"
    },
    "method": {
      "foreground": "#006878"
    },
    "parameter": {
      "foreground": "#8F4B03"
    },
    "property": {
      "foreground": "#59644D"
    },
    "enumMember": {
      "foreground": "#59644D"
    },
    "variable": {
      "foreground": "#20211F"
    },
    "keyword": {
      "foreground": "#AD4439"
    },
    "number": {
      "foreground": "#90326C"
    },
    "boolean": {
      "foreground": "#90326C"
    },
    "string": {
      "foreground": "#334C5B"
    },
    "*.documentation": {
      "foreground": "#6C6C6C"
    },
    "class.documentation": {
      "foreground": "#517395",
      "bold": false
    },
    "interface.documentation": {
      "foreground": "#517395",
      "bold": false
    },
    "enum.documentation": {
      "foreground": "#517395",
      "bold": false
    },
    "type.documentation": {
      "foreground": "#517395",
      "bold": false
    },
    "parameter.documentation": {
      "foreground": "#70706F"
    },
    "variable.documentation": {
      "foreground": "#70706F"
    },
    "keyword.documentation": {
      "foreground": "#9B6058"
    }
  }
}

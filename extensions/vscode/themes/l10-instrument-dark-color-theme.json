  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8E8E8E"
      }
    },
    {
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#8E8E8E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F46757"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#77A7D5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#52B8CA"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E79A41"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#AABA9B"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#E8E6DF"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9BB4C2"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#DB88B8"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#DB88B8"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#B6B5AF"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#979791"
      }
    },
    {
      "scope": [
        "punctuation.section",
        "punctuation.section.braces"
      ],
      "settings": {
        "foreground": "#A9A8A2"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other"
      ],
      "settings": {
        "foreground": "#E79A41"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F46757"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#AABA9B"
      }
    },
    {
      "scope": [
        "comment.block.documentation storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#BC7469",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment.block.documentation entity.name.type.jsdoc"
      ],
      "settings": {
        "foreground": "#7B93AB"
      }
    },
    {
      "scope": [
        "comment.block.documentation entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#7B93AB",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment.block.documentation variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#8E8E8B"
      }
    },
    {
      "scope": [
        "comment.block.documentation variable.other.description.jsdoc",
        "comment.block.documentation constant.other.description.jsdoc"
      ],
      "settings": {
        "foreground": "#8E8E8E"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#77A7D5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#9BB4C2"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#52B8CA"
      }
    },
    {
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.heading.markdown",
        "punctuation.definition.bold.markdown",
        "punctuation.definition.italic.markdown",
        "punctuation.definition.link.markdown"
      ],
      "settings": {
        "foreground": "#979791"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "foreground": "#77A7D5",
      "bold": true
    },
    "interface": {
      "foreground": "#77A7D5",
      "bold": true
    },
    "enum": {
      "foreground": "#77A7D5",
      "bold": true
    },
    "type": {
      "foreground": "#77A7D5",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#77A7D5"
    },
    "function": {
      "foreground": "#52B8CA"
    },
    "method": {
      "foreground": "#52B8CA"
    },
    "parameter": {
      "foreground": "#E79A41"
    },
    "property": {
      "foreground": "#AABA9B"
    },
    "enumMember": {
      "foreground": "#AABA9B"
    },
    "variable": {
      "foreground": "#E8E6DF"
    },
    "keyword": {
      "foreground": "#F46757"
    },
    "number": {
      "foreground": "#DB88B8"
    },
    "boolean": {
      "foreground": "#DB88B8"
    },
    "string": {
      "foreground": "#9BB4C2"
    },
    "*.documentation": {
      "foreground": "#8E8E8E"
    },
    "class.documentation": {
      "foreground": "#7B93AB",
      "bold": false
    },
    "interface.documentation": {
      "foreground": "#7B93AB",
      "bold": false
    },
    "enum.documentation": {
      "foreground": "#7B93AB",
      "bold": false
    },
    "type.documentation": {
      "foreground": "#7B93AB",
      "bold": false
    },
    "parameter.documentation": {
      "foreground": "#8E8E8B"
    },
    "variable.documentation": {
      "foreground": "#8E8E8B"
    },
    "keyword.documentation": {
      "foreground": "#BC7469"
    }
  }
}

  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "{code.comment}"
      }
    },
    {
      "scope": ["comment.block.documentation"],
      "settings": {
        "foreground": "{code.comment}",
        "fontStyle": "{style.annotation}"
      }
    },
    {
      "scope": ["keyword.control", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "{code.control}"
      }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class"],
      "settings": {
        "foreground": "{code.structure}",
        "fontStyle": "{weight.structure}"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "{code.behaviour}"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "{code.input}"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "{code.property}"
      }
    },
    {
      "scope": ["variable", "identifier"],
      "settings": {
        "foreground": "{code.variable}"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "{code.literal}"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "{code.scalar}"
      }
    },
    {
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "{code.scalar}"
      }
    },
    {
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": {
        "foreground": "{code.operator}"
      }
    },
    {
      "scope": ["punctuation", "punctuation.definition"],
      "settings": {
        "foreground": "{code.punctuation}"
      }
    },
    {
      "scope": ["punctuation.section", "punctuation.section.braces"],
      "settings": {
        "foreground": "{code.bracket}"
      }
    },
    {
      "scope": ["constant.character.escape", "constant.other"],
      "settings": {
        "foreground": "{code.input}"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "{code.control}"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "{code.property}"
      }
    },
    {
      "scope": ["comment.block.documentation storage.type.class.jsdoc"],
      "settings": {
        "foreground": "{documentation.control}",
        "fontStyle": ""
      }
    },
    {
      "scope": ["comment.block.documentation entity.name.type.jsdoc"],
      "settings": {
        "foreground": "{documentation.structure}"
      }
    },
    {
      "scope": ["comment.block.documentation entity.name.type.instance.jsdoc"],
      "settings": {
        "foreground": "{documentation.structure}",
        "fontStyle": ""
      }
    },
    {
      "scope": ["comment.block.documentation variable.other.jsdoc"],
      "settings": {
        "foreground": "{documentation.variable}"
      }
    },
    {
      "scope": [
        "comment.block.documentation variable.other.description.jsdoc",
        "comment.block.documentation constant.other.description.jsdoc"
      ],
      "settings": {
        "foreground": "{code.comment}"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "{code.title}",
        "fontStyle": "{weight.strong}"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": {
        "foreground": "{code.literal}"
      }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "{code.link}"
      }
    },
    {
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "punctuation.definition.heading.markdown",
        "punctuation.definition.bold.markdown",
        "punctuation.definition.italic.markdown",
        "punctuation.definition.link.markdown"
      ],
      "settings": {
        "foreground": "{code.punctuation}"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "{code.structure}",
      "bold": "{weight.structure}"
    },
    "interface": {
      "foreground": "{code.structure}",
      "bold": "{weight.structure}"
    },
    "enum": {
      "foreground": "{code.structure}",
      "bold": "{weight.structure}"
    },
    "type": {
      "foreground": "{code.structure}",
      "bold": "{weight.structure}"
    },
    "typeParameter": {
      "foreground": "{code.structure}"
    },
    "function": {
      "foreground": "{code.behaviour}"
    },
    "method": {
      "foreground": "{code.behaviour}"
    },
    "parameter": {
      "foreground": "{code.input}"
    },
    "property": {
      "foreground": "{code.property}"
    },
    "enumMember": {
      "foreground": "{code.property}"
    },
    "variable": {
      "foreground": "{code.variable}"
    },
    "keyword": {
      "foreground": "{code.control}"
    },
    "number": {
      "foreground": "{code.scalar}"
    },
    "boolean": {
      "foreground": "{code.scalar}"
    },
    "string": {
      "foreground": "{code.literal}"
    },
    "*.documentation": {
      "foreground": "{code.comment}"
    },
    "class.documentation": {
      "foreground": "{documentation.structure}",
      "bold": false
    },
    "interface.documentation": {
      "foreground": "{documentation.structure}",
      "bold": false
    },
    "enum.documentation": {
      "foreground": "{documentation.structure}",
      "bold": false
    },
    "type.documentation": {
      "foreground": "{documentation.structure}",
      "bold": false
    },
    "parameter.documentation": {
      "foreground": "{documentation.variable}"
    },
    "variable.documentation": {
      "foreground": "{documentation.variable}"
    },
    "keyword.documentation": {
      "foreground": "{documentation.control}"
    }
  }
}
